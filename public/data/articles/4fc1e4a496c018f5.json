if]--></td></tr></tbody></table><!--[if mso | IE]>\n</td></tr></table>\n<![endif]-->\n\n \n \n <!--[if mso | IE]>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"mb-pd-title-outlook row-mb-pd-outlook\" style=\"width:600px;\" width=\"600\"><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n<![endif]--><table><tbody><tr><td><!--[if mso | IE]>\n<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"vertical-align:top;width:592px;\">\n<![endif]--><table>\n <tbody><tr><td><h2><a href=\"https://frienji.kenjilopezalt.com/posts/knife-making-in-167560578?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=167560578\" target=\"_blank\" rel=\"noopener noreferrer\"><span>Knife Making In Sanjō (With Aiba Steel) | Kenji Eats Japan</span></a></h2></td></tr>\n <tr><td>\n \n <table>\n <tbody>\n <tr>\n \n <td>\n <table><tbody><tr><td><a href=\"https://frienji.kenjilopezalt.com/?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=creator_link\" target=\"_blank\" rel=\"noopener noreferrer\"><span><img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/campaign/4148811/84ab17c91c0c4ce3827945b58e78b21e/eyJoIjo3NSwidyI6NzV9/2.jpg?token-hash=HehEy5SavkB4Cs2YLgv4QLNK8ZmJaEfINruXShVgTzo%3D\" width=\"42\" loading=\"lazy\" decoding=\"async\"></span></a></td></tr></tbody></table>\n </td>\n \n <td>\n \n \n <h4><a href=\"https://frienji.kenjilopezalt.com/?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=creator_link\" target=\"_blank\" rel=\"noopener noreferrer\"><span>J. Kenji López-Alt</span></a></h4>\n \n \n Aug 24, 2026\n \n </td>\n </tr>\n </tbody>\n </table>\n \n </td></tr>\n <tr><td> </td></tr>\n <tr><td>\n \n <table>\n <tbody>\n <tr>\n <td>\n <table><tbody><tr><td><a href=\"https://frienji.kenjilopezalt.com/posts/knife-making-in-167560578?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=167560578\" target=\"_blank\" rel=\"noopener noreferrer\"><!--[if mso | IE]><span style=\"mso-text-raise:-2px;\"><![endif]--><img src=\"https://cdn-web-assets.dyspatch.io/org_01gvh8mwwb22j90stngkwjbkvx/fdr_01jmdv6s5fevecq2mwr1tmmwss%2FmEPm9PuPRYKykZNvWcmk_HeartOutline.png\" width=\"19\" alt=\"like\" loading=\"lazy\" decoding=\"async\"><!--[if mso | IE]></span><![endif]--></a></td></tr></tbody></table>\n </td>\n <td>\n <table><tbody><tr><td><a href=\"https://frienji.kenjilopezalt.com/posts/knife-making-in-167560578?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=167560578\" target=\"_blank\" rel=\"noopener noreferrer\"><!--[if mso | IE]><span style=\"mso-text-raise:-2px;\"><![endif]--><img src=\"https://cdn-web-assets.dyspatch.io/org_01gvh8mwwb22j90stngkwjbkvx/fdr_01jmdv6s5fevecq2mwr1tmmwss%2FpONe1AzqSS2ydddAswCs_BubbleOutlined%20(1).png\" width=\"19\" alt=\"comment\" loading=\"lazy\" decoding=\"async\"><!--[if mso | IE]></span><![endif]--></a></td></tr></tbody></table>\n </td>\n <td>\n <table><tbody><tr><td><a href=\"https://frienji.kenjilopezalt.com/posts/knife-making-in-167560578?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=167560578\" target=\"_blank\" rel=\"noopener noreferrer\"><!--[if mso | IE]><span style=\"mso-text-raise:-2px;\"><![endif]--><img src=\"https://cdn-web-assets.dyspatch.io/org_01gvh8mwwb22j90stngkwjbkvx/fdr_01jmdv6s5fevecq2mwr1tmmwss%2FFkHQyZCfR8O5oErCuqC4_Share%20(2).png\" width=\"19\" alt=\"share\" loading=\"lazy\" decoding=\"async\"><!--[if mso | IE]></span><![endif]--></a></td></tr></tbody></table>\n </td>\n <td>\n \n <table><tbody><tr><td><a href=\"https://open.patreon.com/home?utm_id=23195251-a42c-46b8-8b4f-c0b1e3065bc2&amp;utm_medium=email\" target=\"_blank\" rel=\"noopener noreferrer\">View in app</a></td></tr></tbody></table>\n \n \n <!--[if !mso]--><table><tbody><tr><td><a href=\"https://open.patreon.com/home?utm_id=23195251-a42c-46b8-8b4f-c0b1e3065bc2&amp;utm_medium=email\" target=\"_blank\" rel=\"noopener noreferrer\">View in app</a></td></tr></tbody></table><!--[endif]-->\n \n </td>\n </tr>\n </tbody>\n </table>\n \n </td></tr>\n </tbody></table><!--[if mso | IE]>\n</td></tr></table>\n<![endif]--></td></tr></tbody></table><!--[if mso | IE]>\n</td></tr></table>\n<![endif]-->\n \n <!--[if mso | IE]>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"row-mb-pd-outlook\" style=\"width:600px;\" width=\"600\"><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n<![endif]--><table><tbody><tr><td><!--[if mso | IE]>\n<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"vertical-align:top;width:576px;\">\n<![endif]--><table>\n <tbody><tr><td><h3><em>In pursuit of the perfect kitchen knife, we traveled to Tsubame-Sanjō, a world-famous metalworking region in Japan, with the help of some friends. </em></h3><p>Hi Frienjis,</p><p>It’s Erin, Community &amp; Content Manager here with a special episode of <strong>Kenji Eats Japan.</strong></p><p>So far in this series, we’ve brought you along to <strong><a href=\"https://frienji.kenjilopezalt.com/posts/exploring-food-164490961\" target=\"_blank\" rel=\"noopener noreferrer\">basement food courts</a></strong> and <strong><a href=\"https://frienji.kenjilopezalt.com/posts/enjoy-tofu-lunch-165137604\" target=\"_blank\" rel=\"noopener noreferrer\">elegant tofu lunches,</a></strong><strong> </strong>we’ve enjoyed <strong><a href=\"https://frienji.kenjilopezalt.com/posts/introducing-eats-162823119\" target=\"_blank\" rel=\"noopener noreferrer\">Hokkaido milk flights</a></strong> and <strong><a href=\"https://frienji.kenjilopezalt.com/posts/konbini-taste-166949319\" target=\"_blank\" rel=\"noopener noreferrer\">konbini taste tests,</a></strong> and we’ve made a <strong><a href=\"https://frienji.kenjilopezalt.com/collection/2272438?view=expanded\" target=\"_blank\" rel=\"noopener noreferrer\">whole lot of recipes</a></strong> inspired by our team’s travels through Japan earlier this year. </p><p><strong>But why were we in Japan to begin with? </strong>The story starts in Falls City, Oregon, and ends in Tsubame-Sanjō, Niigata Prefecture, Japan. Come along!</p><a href=\"https://frienji.kenjilopezalt.com/collection/2272438?view=expanded\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <table>\n        <tbody>\n          <tr>\n            <td>\n                <img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/post/167560578/0a3301d2b59446d8ad0c32862c8db62f/eyJhIjoxLCJ3Ijo4MjB9/1.png?token-hash=oZgnL26bvDnZsEuqsrjwP0xg7D365bNJ_LYDStd0UV0%3D&amp;token-time=1788825600\" width=\"592\" loading=\"lazy\" decoding=\"async\">\n            </td>\n          </tr>\n        </tbody>\n      </table>\n        </a><h2>A Series Of <em>Fortunate</em> Events</h2><p><em>A long time ago in a tiny Oregon town far, far away…</em> </p><p>Kenji met Gordon Hanson of <strong><a href=\"https://www.vonhelmickknives.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Vonhelmick Knives</a></strong> by total happenstance during a road trip. Being a chef and artisan knife maker respectively, a friendship was quickly born, as was a <strong><a href=\"https://www.vonhelmickknives.com/kenji\" target=\"_blank\" rel=\"noopener noreferrer\">beautiful knife partnership.</a></strong><strong> </strong></p><p>At Vonhelmick, all knives are hand-forged and just as Gordon’s steel supply started to diminish, luck struck again in the shape of a new friend, Eugene, who does a lot of business in Japan and wanted to help Gordon find a Japanese steel supplier. In the final link in this lucky chain, he eventually made the connection between Gordon, Kenji, and the family behind Aiba Steel. <strong>Then we were off to the races.</strong></p><a href=\"https://frienji.kenjilopezalt.com/posts/knife-making-in-167560578?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=167560578&amp;media_id=724360275\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <table>\n        <tbody>\n          <tr>\n            <td>\n                <img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/post/167560578/5afd2a37c21a4b3880d919cb7fbe812e/eyJhIjoxLCJ3Ijo4MjB9/1.png?token-hash=bRNFXNkp92P6vpYNxNDoiWogQwIvlASHHXSt-MF8aGo%3D&amp;token-time=1788825600\" width=\"592\" loading=\"lazy\" decoding=\"async\">\n            </td>\n          </tr>\n        </tbody>\n      </table>\n        </a><p>Inside the historic, former headquarters of Aiba Steel, featuring photos of some of the family's ancestors.</p><h2>Working Together</h2><p><strong><a href=\"https://www.aiba-steel.co.jp/en/\" target=\"_blank\" rel=\"noopener noreferrer\">Aiba Steel</a></strong> has been a family-run business since the Edo Period when their original hardware store opened their doors in 1861. Their business is guided by the founding principles of being kind and gentle, always being open to new challenges, and working hard to maintain the essence of their workers, partners, and local community.<strong><a href=\"https://www.aiba-steel.co.jp/en/?company=greeting-company\" target=\"_blank\" rel=\"noopener noreferrer\">¹</a></strong></p><p>Following in this tradition, the Aibas prefer to do business face to face. As their President Ryoji Aiba put it: <em>“Building trust with clients requires more than just emailing or video calling… you should look at the other person in the face and shake their hand. That’s how you build trust.” </em>This partnership bloomed over various trips to Oregon, a few stops in Seattle, and finally, <strong>a journey back to the Aibas’ hometown, Sanjō, in April of this year.</strong></p><a href=\"https://frienji.kenjilopezalt.com/posts/knife-making-in-167560578?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=167560578&amp;media_id=724339643\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <table>\n        <tbody>\n          <tr>\n            <td>\n                <img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/post/167560578/8cadfa6a7dc84cb18e0b8f43e3503512/eyJhIjoxLCJ3Ijo4MjB9/1.png?token-hash=Evq-mSbtlzgbFiffBsMwjgIY6Nj4dFrmitlT4l978Jw%3D&amp;token-time=1788825600\" width=\"592\" loading=\"lazy\" decoding=\"async\">\n            </td>\n          </tr>\n        </tbody>\n      </table>\n        </a><p>The Sanjō Hachimangu Shrine, the Aibas' hometown shrine.</p><p>Tsubame-Sanjō is an area in Niigata Prefecture that combines the cities of Tsubame and Sanjō and is <strong>world-famous for its metalworking and manufacturing</strong>. There are over 5,000 small- to medium-sized companies located here and they host a particular fame for their cutlery craft, including some of the best Japanese knives you can get your hands on.<strong><a href=\"https://thehiddenjapan.com/tsubame-sanjo/\" target=\"_blank\" rel=\"noopener noreferrer\">²</a></strong><strong> </strong><strong><a href=\"https://www.japan.travel/en/spot/2063/\" target=\"_blank\" rel=\"noopener noreferrer\">³</a></strong> In this industrial core, you’ll spot countless factories, foundries, workshops and forges. The roads are russet—a coloration they get from an actual coating of oxidized iron*, not a chosen, stylistic design choice—and the manhole covers are <strong><a href=\"https://frienji.kenjilopezalt.com/posts/introducing-eats-162823119\" target=\"_blank\" rel=\"noopener noreferrer\">decorated with blacksmithing tools.</a></strong></p><p>The devotion to their craft is etched, literally, in every part of the region.</p><a href=\"https://frienji.kenjilopezalt.com/posts/knife-making-in-167560578?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=167560578&amp;media_id=724348514\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <table>\n        <tbody>\n          <tr>\n            <td>\n                <img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/post/167560578/456e9e194a8042a7a8342296dc14010d/eyJhIjoxLCJ3Ijo4MjB9/1.png?token-hash=x0gYBrp_z5xXtnduEnZaKHeJeatAp3b_Hi84F52pJgE%3D&amp;token-time=1788825600\" width=\"592\" loading=\"lazy\" decoding=\"async\">\n            </td>\n          </tr>\n        </tbody>\n      </table>\n        </a><p><em><strong>*</strong></em><em>According to legend, the rust-coated streets come from airborne iron particles from the many nearby factories. The reality is a bit different, as it’s largely thanks to their sprinkler-based snow removal system that sprays warm water—which does contain higher levels of iron—across streets to help melt snow during the winter months. See their local train station above with the iconic rusty roads. </em><strong><a href=\"https://knifewear.com/en-us/blogs/articles/small-maker-series-toshihiro-wakui\" target=\"_blank\" rel=\"noopener noreferrer\">⁴</a></strong></p><h2>The Ultimate Hosts</h2><p>While hosting the entire Vonhelmick<strong> </strong>(Hanson) family, extended JKLA crew, and business partner Eugene, the Aibas <strong>never wavered as the ultimate hosts.</strong> It’s hard to put into words the grace and thought they put into every aspect of our visit: Organizing multiple days of factory and foundry tours and activities to not only see different applications of their steel, but to really understand their metalworking culture; arranging chef demonstrations so our crew could gain insight to the local food scene; inviting us to get to know their business partners and, likewise, trusting us to share the story with all of you.</p><a href=\"https://frienji.kenjilopezalt.com/posts/knife-making-in-167560578?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=167560578&amp;media_id=724371692\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <table>\n        <tbody>\n          <tr>\n            <td>\n                <img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/post/167560578/03719e501e054832a7051e1d643494df/eyJhIjoxLCJ3Ijo4MjB9/1.png?token-hash=3JjQKATAXVolw5KLb7bT7U0trz_G4V56ocFg52G4ydw%3D&amp;token-time=1788825600\" width=\"592\" loading=\"lazy\" decoding=\"async\">\n            </td>\n          </tr>\n        </tbody>\n      </table>\n        </a><p>One of the beautiful ryokans we stayed in.</p><p>During our visit, we stayed in beautiful ryokans (inns) and were treated to kaiseki meals (traditional multi-course dinners) that featured impressively local and seasonal ingredients. Across three days, these courses featured everything from cherry salmon, rockfish, carp, and shellfish to <strong><a href=\"https://butchershoppedirect.com/blogs/latest-buzz/snow-aged-wagyu?srsltid=AfmBOorA4b01poDAwchcgnHvwPpxc9jGyDCiqqhFM6q_gGegYoFgBtgX\" target=\"_blank\" rel=\"noopener noreferrer\">snow-aged wagyu</a></strong> to seasonal vines, shoots, and bulbs. There were soup courses, tempura courses, and bowls of rice that were cultivated in the very town we stayed in. Every meal began with a toast of either non-alcoholic yuzu juice or a local sake and ended with a round of dessert and a cup of green tea. (Including my personal favorite: Build-it-yourself ice cream sandwiches with a selection of orange marmalade and red bean paste toppings and warabimochi and ichigo daifuku on the side.)</p><a href=\"https://frienji.kenjilopezalt.com/posts/knife-making-in-167560578?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=167560578&amp;media_id=724328619\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <table>\n        <tbody>\n          <tr>\n            <td>\n                <img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/post/167560578/05448ffabadd4ddaaa902838ca4ca7cf/eyJhIjoxLCJ3Ijo4MjB9/1.png?token-hash=aCR1XYW39eKWIiqtqg4L1U2S8dw3VdYR0VFUlGHMZhY%3D&amp;token-time=1788825600\" width=\"592\" loading=\"lazy\" decoding=\"async\">\n            </td>\n          </tr>\n        </tbody>\n      </table>\n        </a><p>The first course of the evening.</p><p>Through every tour, activity, and conversation, you could feel the attention to detail the family and their community put into their local industry. Through every ingredient and course served at dinner, you could feel the pride they have for their home shine through—and deservedly so. In fact, the minute I got back to Seattle, I headed down to Uwajimaya, our local Japanese grocery store, and bought some Niigata-grown rice myself.</p><a href=\"https://frienji.kenjilopezalt.com/posts/knife-making-in-167560578?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=167560578&amp;media_id=724368261\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <table>\n        <tbody>\n          <tr>\n            <td>\n                <img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/post/167560578/57dae812f3f249f1b4d4d01a3c99b63e/eyJhIjoxLCJ3Ijo4MjB9/1.png?token-hash=0TJMe0or0py3XufywBwDKKT5lW3DeqPIXZ-KqMahZag%3D&amp;token-time=1788825600\" width=\"592\" loading=\"lazy\" decoding=\"async\">\n            </td>\n          </tr>\n        </tbody>\n      </table>\n        </a><p>And as a bonus, being up north in Niigata we were also able to catch the tail end of cherry blossom season!</p><h2>Follow the Journey</h2><p>We hope you enjoy this special episode of <strong>Kenji Eats Japan</strong> bringing you along to Sanjō with us. And stay tuned as the team gets to work making the next iteration of the <strong><a href=\"https://www.vonhelmickknives.com/kenji\" target=\"_blank\" rel=\"noopener noreferrer\">Kenji x Vonhelmick Shi-Toku knife</a></strong> the best one possible.</p><p>— Erin, Community &amp; Content Manager</p><h2><strong><a href=\"https://frienji.kenjilopezalt.com/collection/2272438?view=expanded\" target=\"_blank\" rel=\"noopener noreferrer\">🔗 Watch the full Kenji Eats Japan series.</a></strong></h2></td></tr>\n </tbody></table><!--[if mso | IE]>\n</td></tr></table>\n<![endif]--></td></tr></tbody></table><!--[if mso | IE]>\n</td></tr></table>\n<![endif]-->\n\n \n \n <!--[if mso | IE]>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"row-mb-pd-outlook\" style=\"width:600px;\" width=\"600\"><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n<![endif]--><table><tbody><tr><td><!--[if mso | IE]>\n<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n<![endif]--><!--[if mso | IE]>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"mb-pd-cr-outlook card-pd-32-outlook mb-crd-pd-outlook\" style=\"width:592px;\" width=\"592\"><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n<![endif]--><table><tbody><tr><td><!--[if mso | IE]>\n<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"vertical-align:top;width:544px;\">\n<![endif]--><table>\n <tbody><tr><td>\n <table>\n <tbody>\n <tr>\n <td>\n <table>\n <tbody>\n <tr>\n <td>\n <table><tbody><tr><td><img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/campaign/4148811/84ab17c91c0c4ce3827945b58e78b21e/eyJoIjoxMjAsInciOjEyMH0%3D/2.jpg?token-hash=xuPmGP7K1uw3-q_PmYUEqXXM_t3IUV7o2PbVJZ_CLDY%3D\" width=\"60\" loading=\"lazy\" decoding=\"async\"></td></tr></tbody></table>\n </td>\n <td>\n <table>\n <tbody>\n <tr>\n <td>\n <h4><p> Did you like this post?</p></h4>\n </td>\n </tr>\n <tr>\n <td>\n <p> Share this post with someone who might enjoy it.</p>\n </td>\n </tr>\n </tbody>\n </table>\n </td>\n </tr>\n </tbody>\n </table>\n </td>\n <td>\n <table><tbody><tr><td><a href=\"https://frienji.k