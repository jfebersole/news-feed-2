ndif]--></td></tr></tbody></table><!--[if mso | IE]>\n</td></tr></table>\n<![endif]-->\n\n \n \n <!--[if mso | IE]>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"mb-pd-title-outlook row-mb-pd-outlook\" style=\"width:600px;\" width=\"600\"><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n<![endif]--><table><tbody><tr><td><!--[if mso | IE]>\n<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"vertical-align:top;width:592px;\">\n<![endif]--><table>\n <tbody><tr><td><h2><a href=\"https://frienji.kenjilopezalt.com/posts/bring-japan-home-168610463?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=168610463\" target=\"_blank\" rel=\"noopener noreferrer\"><span>Bring Japan Home With You (Japanese Pantry Staples) | Kenji Eats Japan </span></a></h2></td></tr>\n <tr><td>\n \n <table>\n <tbody>\n <tr>\n \n <td>\n <table><tbody><tr><td><a href=\"https://frienji.kenjilopezalt.com/?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=creator_link\" target=\"_blank\" rel=\"noopener noreferrer\"><span><img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/campaign/4148811/84ab17c91c0c4ce3827945b58e78b21e/eyJoIjo3NSwidyI6NzV9/2.jpg?token-hash=HehEy5SavkB4Cs2YLgv4QLNK8ZmJaEfINruXShVgTzo%3D\" width=\"42\" loading=\"lazy\" decoding=\"async\"></span></a></td></tr></tbody></table>\n </td>\n \n <td>\n \n \n <h4><a href=\"https://frienji.kenjilopezalt.com/?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=creator_link\" target=\"_blank\" rel=\"noopener noreferrer\"><span>J. Kenji López-Alt</span></a></h4>\n \n \n Sep 4, 2026\n \n </td>\n </tr>\n </tbody>\n </table>\n \n </td></tr>\n <tr><td> </td></tr>\n <tr><td>\n \n <table>\n <tbody>\n <tr>\n <td>\n <table><tbody><tr><td><a href=\"https://frienji.kenjilopezalt.com/posts/bring-japan-home-168610463?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=168610463\" target=\"_blank\" rel=\"noopener noreferrer\"><!--[if mso | IE]><span style=\"mso-text-raise:-2px;\"><![endif]--><img src=\"https://cdn-web-assets.dyspatch.io/org_01gvh8mwwb22j90stngkwjbkvx/fdr_01jmdv6s5fevecq2mwr1tmmwss%2FmEPm9PuPRYKykZNvWcmk_HeartOutline.png\" width=\"19\" alt=\"like\" loading=\"lazy\" decoding=\"async\"><!--[if mso | IE]></span><![endif]--></a></td></tr></tbody></table>\n </td>\n <td>\n <table><tbody><tr><td><a href=\"https://frienji.kenjilopezalt.com/posts/bring-japan-home-168610463?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=168610463\" target=\"_blank\" rel=\"noopener noreferrer\"><!--[if mso | IE]><span style=\"mso-text-raise:-2px;\"><![endif]--><img src=\"https://cdn-web-assets.dyspatch.io/org_01gvh8mwwb22j90stngkwjbkvx/fdr_01jmdv6s5fevecq2mwr1tmmwss%2FpONe1AzqSS2ydddAswCs_BubbleOutlined%20(1).png\" width=\"19\" alt=\"comment\" loading=\"lazy\" decoding=\"async\"><!--[if mso | IE]></span><![endif]--></a></td></tr></tbody></table>\n </td>\n <td>\n <table><tbody><tr><td><a href=\"https://frienji.kenjilopezalt.com/posts/bring-japan-home-168610463?utm_medium=newsletter_post_email&amp;utm_campaign=patron_engagement&amp;utm_source=post_link&amp;post_id=168610463\" target=\"_blank\" rel=\"noopener noreferrer\"><!--[if mso | IE]><span style=\"mso-text-raise:-2px;\"><![endif]--><img src=\"https://cdn-web-assets.dyspatch.io/org_01gvh8mwwb22j90stngkwjbkvx/fdr_01jmdv6s5fevecq2mwr1tmmwss%2FFkHQyZCfR8O5oErCuqC4_Share%20(2).png\" width=\"19\" alt=\"share\" loading=\"lazy\" decoding=\"async\"><!--[if mso | IE]></span><![endif]--></a></td></tr></tbody></table>\n </td>\n <td>\n \n <table><tbody><tr><td><a href=\"https://open.patreon.com/home?utm_id=926742cf-36c7-4157-94a8-3d2fa3fd73c5&amp;utm_medium=email\" target=\"_blank\" rel=\"noopener noreferrer\">View in app</a></td></tr></tbody></table>\n \n \n <!--[if !mso]--><table><tbody><tr><td><a href=\"https://open.patreon.com/home?utm_id=926742cf-36c7-4157-94a8-3d2fa3fd73c5&amp;utm_medium=email\" target=\"_blank\" rel=\"noopener noreferrer\">View in app</a></td></tr></tbody></table><!--[endif]-->\n \n </td>\n </tr>\n </tbody>\n </table>\n \n </td></tr>\n </tbody></table><!--[if mso | IE]>\n</td></tr></table>\n<![endif]--></td></tr></tbody></table><!--[if mso | IE]>\n</td></tr></table>\n<![endif]-->\n \n <!--[if mso | IE]>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"row-mb-pd-outlook\" style=\"width:600px;\" width=\"600\"><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n<![endif]--><table><tbody><tr><td><!--[if mso | IE]>\n<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"vertical-align:top;width:576px;\">\n<![endif]--><table>\n <tbody><tr><td><h3><em>Follow along as we walk you through every aisle in a Japanese grocery store for a complete guide on stocking your pantry. This extended cut is exclusive for Patreon!</em></h3><p>Hi Frienjis,</p><p>Community &amp; Content Manager Erin here with our <strong>very last episode of the Kenji Eats Japan series!</strong> </p><p>Earlier this year, our team traveled to Japan in search of good food and even better kitchen knives <strong><a href=\"https://frienji.kenjilopezalt.com/posts/introducing-eats-162823119\" target=\"_blank\" rel=\"noopener noreferrer\">(get the full story here).</a></strong> We knew we had to bring some of that culinary magic back for you. That’s why, today, we’re walking you through how to make that a reality with Kenji’s ultimate guide on <strong><a href=\"https://frienji.kenjilopezalt.com/posts/kenjis-complete-168379584?pr=true\" target=\"_blank\" rel=\"noopener noreferrer\">How to Stock a Japanese Pantry. </a></strong></p><a href=\"https://frienji.kenjilopezalt.com/collection/2272438?view=expanded\" target=\"_blank\" rel=\"noopener noreferrer\">\n        <table>\n        <tbody>\n          <tr>\n            <td>\n                <img src=\"https://c10.patreonusercontent.com/4/patreon-media/p/post/167560578/0a3301d2b59446d8ad0c32862c8db62f/eyJhIjoxLCJ3Ijo4MjB9/1.png?token-hash=oe0KgBGExWCbOst3vs4fEUwm-0eRLvLXM12ZJvrtH1E%3D&amp;token-time=1789776000\" width=\"592\" loading=\"lazy\" decoding=\"async\">\n            </td>\n          </tr>\n        </tbody>\n      </table>\n        </a><h2>Kenji Ate Japan… Now You Can, Too!</h2><p>If you’re at all familiar with Japanese cuisine, you might be able to guess some of the basics Kenji will recommend: Soy sauce, miso paste, dashi, maybe a shiso leaf if you’re feeling fancy. But unlike most pantry hauls, this one is not just scratching the surface. </p><p>With the help of our local Japanese grocery store, we <strong>walked down each aisle and covered everything</strong> from ginkgo nuts and shungiku greens to different types of fish roe, cooking sauces, seaweeds, and more. We debated the tenets of microwavable rice (we’re not mad about it); whether you should make Japanese curry from scratch (probably not); and if you should stick to powdered wasabi or cash out on the real root (at $299.99 per pound? We’ll stick to the S&amp;B tins, please)!</p><p>Special thank you to <strong>Uwajimaya</strong> for allowing us to film in their Seattle location for this video. If you’re ever in the area, we must recommend a visit to <strong><a href=\"https://www.uwajimaya.com/who-we-are/\" target=\"_blank\" rel=\"noopener noreferrer\">this iconic grocery shop</a></strong>—you won’t be disappointed with what you find. </p><h2>How To Stock A Japanese Pantry (Extended)</h2><p>All Frienjis here on Patreon can enjoy the <strong>extended cut of the video above.</strong> You can also dive into the full written article by Kenji here: <strong><a href=\"https://frienji.kenjilopezalt.com/posts/kenjis-complete-168379584?pr=true\" target=\"_blank\" rel=\"noopener noreferrer\">How to Stock a Japanese Pantry 🔗</a></strong></p><p>Now sit back and enjoy the haul! And don’t forget, Super Frienjis enjoy exclusive access to the written recipes from <strong><a href=\"https://frienji.kenjilopezalt.com/collection/2272438?view=expanded\" target=\"_blank\" rel=\"noopener noreferrer\">this series.</a></strong> If you haven't already, <strong><a href=\"https://frienji.kenjilopezalt.com/membership\" target=\"_blank\" rel=\"noopener noreferrer\">consider joining today</a></strong> to put your newly-stocked pantry to the test!</p><h2>Thank you for supporting Kenji Eats Japan!</h2><p>This series has been something special for our team to work on. We know it’s a little different from the content you’re used to and we are <strong>so grateful for your support.</strong></p><p>Now, our team is getting started on the next big batch of content we’ll be bringing you. Keep your eyes peeled, Frienjis!</p><p>Until then,</p><p>— Erin, Community &amp; Content Manager</p><h2><strong><a href=\"https://frienji.kenjilopezalt.com/collection/2272438?view=expanded\" target=\"_blank\" rel=\"noopener noreferrer\">🔗 Watch the full Kenji Eats Japan series.</a></strong></h2></td></tr>\n </tbody></table><!--[if mso | IE]>\n</td></tr></table>\n<![endif]--></td></tr></tbody></table><!--[if mso | IE]>\n</td></tr></table>\n<![endif]-->\n\n \n \n <!--[if mso | IE]>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"row-mb-pd-outlook\" style=\"width:600px;\" width=\"600\"><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n<![endif]--><table><tbody><tr><td><!--[if mso | IE]>\n<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\">\n<![endif]--><!--[if mso | IE]>\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"mb-pd-cr-outlook card-pd-32-outlook mb-crd-pd-outlook\" style=\"width:592px;\" width=\"592\"><tr><t